[Unit]
Description=BRS Ryadom Telegram bot and Mini App
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Create the brsy system user and install the repository in /opt/brsy first.
User=brsy
Group=brsy
WorkingDirectory=/opt/brsy
EnvironmentFile=/opt/brsy/.env
Environment=HOST=127.0.0.1
Environment=DATABASE_PATH=/var/lib/brsy/brsy.sqlite3
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/brsy/.venv/bin/python -m brsy
Restart=on-failure
RestartSec=15
StateDirectory=brsy
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
