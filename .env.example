# Create a bot using @BotFather. Never commit this file with actual values.
BOT_TOKEN=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key with your database backup. Do not regenerate on restarts.
ENCRYPTION_KEY=
DATABASE_PATH=data/brsy.sqlite3
HOST=127.0.0.1
PORT=8000
# Optional. Public HTTPS URL of this process through your reverse proxy/tunnel.
MINI_APP_URL=
# Minimum 60 seconds; default 5 minutes per account.
POLL_INTERVAL=300
# Local UI preview only. Must be false when connecting real accounts.
DEMO_MODE=false
